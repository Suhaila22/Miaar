# Copy this file to .env and fill in real values before running the app.

# MySQL connection string, e.g. mysql://user:password@localhost:3306/miyar
DATABASE_URL=

# Long random secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Email address that is automatically promoted to the "admin" role the first
# time it registers or claims an admin-provisioned account. Optional but
# recommended so you have at least one administrator on a fresh database.
OWNER_EMAIL=

# API key for the AI judging/summarization features. Works out of the box
# with OpenAI (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# Optional: point at any other OpenAI-compatible chat-completions provider
# instead of OpenAI (must support tools + json_schema response_format).
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: directory (relative to the project root) where uploaded evidence
# files and generated assets are stored.
# UPLOADS_DIR=uploads

# Optional: webhook URL (e.g. a Slack incoming webhook) that receives
# "notify owner" messages sent from the admin dashboard.
# OWNER_NOTIFICATION_WEBHOOK_URL=

# Port the server listens on (an available port starting from this one is
# used automatically if it's taken).
PORT=3000
